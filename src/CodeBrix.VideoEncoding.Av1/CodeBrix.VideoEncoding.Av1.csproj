<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.VideoEncoding.Av1</AssemblyName>
    <RootNamespace>CodeBrix.VideoEncoding.Av1</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Keep the committed native libraries out of the SDK's default item globs. Without this they arrive as
      None items with no metadata AS WELL AS through the explicit item below, and the metadata-less copies
      win, so nothing reaches the package.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);runtimes\**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.VideoEncoding.Av1.BsdLicenseForever</PackageId>
    <Product>CodeBrix.VideoEncoding.Av1</Product>
    <Title>CodeBrix.VideoEncoding.Av1</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>AV1 video encoding for CodeBrix.VideoProcessing. Av1Encoder turns planar I420, I444 or monochrome frames at 8, 10 or 12 bits into AV1 temporal units - constant quality, constrained quality, variable or constant bitrate, or mathematically lossless, with forced key frames, colour signalling and the av1C configuration record for containers - and one Register() call makes it the "av1" encoder of the CodeBrix.VideoProcessing encoder registry. Built over self-built native libraries shipped in the package for Windows x64 and ARM64, macOS Intel and Apple Silicon, Linux x64, ARM64 and RISC-V 64, and Android 13+ ARM64 and x64.</Description>
    <PackageLicenseExpression>BSD-2-Clause</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.VideoEncoding.Av1</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.VideoEncoding.Av1</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>video;av1;encoder;encoding;compression;lossless;native;CodeBrix</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The encoder contract this package implements. The same Core pin as the test project; raise both together. -->
    <PackageReference Include="CodeBrix.VideoProcessing.Core.MitLicenseForever" Version="1.0.284.20" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <!--
    The native codebrix_av1 libraries, each beside LICENSE-Aom.txt (libaom's LICENSE and PATENTS plus the
    notices of the third-party code linked into the encoder). They are built by av1-native-tools/ and committed
    under runtimes/<rid>/native/; nothing here builds them. They are kept out of the SDK's default item globs
    above and named once here. See MAINTAINER-README.txt.
  -->
  <ItemGroup>
    <_Av1NativeLibrary Include="runtimes\**\*" />

    <!--
      Packed into the standard NuGet runtimes layout, so NuGet gives an application the one native for the
      platform it is building for.

      The package path is the BARE "runtimes/" folder. NuGet appends the item's own recursive directory and
      file name to a package path that names a folder, so spelling %(RecursiveDir) out here as well produces
      runtimes/linux-x64/native/linux-x64/native/libcodebrix_av1.so. It is the one piece of this csproj
      worth checking the package for after any change - see MAINTAINER-README.txt.
    -->
    <None Include="@(_Av1NativeLibrary)" Pack="true" PackagePath="runtimes\" />
  </ItemGroup>

</Project>

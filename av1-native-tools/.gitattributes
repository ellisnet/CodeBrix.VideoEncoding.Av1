# The vendored trees must stay byte-identical to their tarballs in upstream-downloads/ on every
# commit and every checkout. The repository root sets "* text=auto eol=lf", which would normalise
# files at `git add` (nasm-2.16.03 ships CRLF files - test/br3104312.asm, nasm.xml, ndisasm.xml -
# and libaom's tree carries binary test data). -text switches every conversion off for both trees.
aom/** -text
nasm/** -text
# The licence text shipped beside every native binary must be byte-identical on all nine RIDs,
# whichever OS checked the repository out and ran the build. Never convert its line endings.
licenses/LICENSE-Aom.txt -text
# Shell scripts and the shared pins must keep LF to run (Windows checkouts included).
*.sh text eol=lf
*.env text eol=lf
# The ELF version script and the macOS export list are read by linkers on every platform.
shim/codebrix_av1.map text eol=lf
shim/codebrix_av1.exports text eol=lf

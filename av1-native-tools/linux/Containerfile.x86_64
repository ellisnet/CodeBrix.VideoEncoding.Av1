# =============================================================================================
# Containerfile.x86_64 - the codebrix_av1 build machine for linux-x64
# =============================================================================================
#
# WHAT THIS IS
#   The digest-pinned manylinux base image (AlmaLinux 8, gcc-toolset 14, glibc 2.28) with a toolchain PROBE on top.
#   It installs NOTHING: the base image already has everything libaom + the shim
#   need (C and C++ compilers - libaom's CMake project enables CXX although nothing C++ is
#   compiled -, cmake, GNU make, binutils, file, and Perl, which libaom's CMake runs to generate
#   its run-time CPU dispatch headers). This step only proves that, fails
#   early and obviously if a tool is ever missing, and writes the versions to
#   /usr/local/share/codebrix-av1-build/toolchain.txt, which every BUILD-INFO.txt copies.
#
#   nasm (needed for libaom's x86-64 assembly) is NOT in this image and is NOT installed: the
#   base image carries yasm 1.3.0, which libaom treats as the lesser assembler and which is never
#   used here. container-build.sh builds the vendored nasm (../nasm, BUILD-TIME TOOL ONLY) inside
#   the container at the start of every build (../build-nasm.sh) and puts it first on PATH.
#
#   Because nothing is installed, build.sh builds this image with --network none too: no step
#   of this tooling uses the network. (CodeBrix.Sdl3's equivalent installs cmake/ninja/-devel
#   headers and is the one network step there; this build has no such need.)
#
#   build.sh builds this image the first time it is needed and reuses it after that.
#   To rebuild deliberately:   FORCE_IMAGE_REBUILD=1 ./build.sh x64
#
# The default BASE_IMAGE below exists only so a hand-run 
# works; build.sh always passes --build-arg BASE_IMAGE from pins.env.
# =============================================================================================

ARG BASE_IMAGE=quay.io/pypa/manylinux_2_28_x86_64@sha256:a61875a2f84cab7df8de222ff12cabc08ff86eb4ad402ac90ba7bdaed9600cca
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="codebrix-av1-build-x86_64"
LABEL org.opencontainers.image.description="codebrix_av1 native build machine: manylinux base + toolchain probe (nothing installed)"
LABEL org.opencontainers.image.source="CodeBrix.VideoEncoding.Av1/av1-native-tools/linux/Containerfile.x86_64"

# ---------------------------------------------------------------------------------------------
# Prove the toolchain. A missing tool fails the IMAGE build, here, where the message is obvious.
# The probe compiles and RUNS a C11 program that uses libm and pthreads, as libaom does.
# ---------------------------------------------------------------------------------------------
RUN set -eu; \
    for t in cc c++ cmake make file nm objdump readelf strip ldd sha256sum perl; do \
        command -v "$t" > /dev/null 2>&1 || { echo "ERROR: $t is missing from the base image." >&2; exit 1; }; \
    done; \
    mkdir -p /usr/local/share/codebrix-av1-build; \
    out=/usr/local/share/codebrix-av1-build/toolchain.txt; \
    { \
      echo "os      : $(grep -m1 PRETTY_NAME /etc/os-release | cut -d= -f2- | tr -d '\"')"; \
      echo "machine : $(uname -m)"; \
      echo "cc      : $(cc --version | sed -n 1p)"; \
      echo "ld      : $(ld --version | sed -n 1p)"; \
      echo "glibc   : $(ldd --version | sed -n 1p)"; \
      echo "cmake   : $(cmake --version | sed -n 1p)"; \
      echo "make    : $(make --version | sed -n 1p)"; \
      echo "c++     : $(c++ --version | sed -n 1p)"; \
      echo "perl    : $(perl -e 'print "perl $^V"')"; \
      echo "yasm    : $(command -v yasm > /dev/null 2>&1 && yasm --version | sed -n 1p || echo 'not present') (never used: libaom is built with the vendored nasm)"; \
      echo "patch   : $(command -v patch > /dev/null 2>&1 && patch --version | sed -n 1p || echo 'not present (only needed if patches/ has a .patch)')"; \
    } > "$out"; \
    cat "$out"; \
    printf '#include <math.h>\n#include <stdio.h>\nint main(void){ volatile double x = 2.0; printf("c11 + libm: %%ld %%.3f\\n", (long)__STDC_VERSION__, sqrt(x)); return 0; }\n' > /tmp/probe.c; \
    cc -std=c11 -pthread -o /tmp/probe /tmp/probe.c -lm; \
    /tmp/probe; \
    rm -f /tmp/probe /tmp/probe.c; \
    echo "toolchain: ok"

WORKDIR /work

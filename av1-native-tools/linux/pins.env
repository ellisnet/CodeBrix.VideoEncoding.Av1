# ==============================================================================================
# pins.env - EVERY version / digest / option pin used by av1-native-tools/linux.
# Edit here only. build.sh sources this file and passes the values into container-build.sh,
# and both echo them at the top of every run, so a build log always says exactly what it used.
# ==============================================================================================

# --- Container images -------------------------------------------------------------------------
# The manylinux images exist to fix the glibc baseline. Building on a modern desktop distro
# bakes THAT distro's glibc version into the .so, and glibc symbol versioning is forward-only,
# so the library would then refuse to load on anything older.
#
#   image                                  glibc  runs on
#   manylinux_2_28_x86_64                  2.28   Debian 10+, Ubuntu 20.04+, RHEL 8+
#   manylinux_2_28_aarch64                 2.28   every 64-bit Raspberry Pi OS, Ubuntu 20.04+
#   manylinux_2_39_riscv64                 2.39   Ubuntu 24.04+, Debian 13+
#
# The same three images, at the same dated tag and the same digests, that CodeBrix.Audio.FlacWriter,
# CodeBrix.Audio.Vorbis, CodeBrix.Sdl3, CodeBrix.VideoPlayback.Dav1d, CodeBrix.Ollama and CodeBrix.Audio pin, so every
# CodeBrix Linux native comes from one base userland. The digest is what the build actually pins.
IMAGE_X64=quay.io/pypa/manylinux_2_28_x86_64:2026.07.19-1
IMAGE_X64_DIGEST=sha256:a61875a2f84cab7df8de222ff12cabc08ff86eb4ad402ac90ba7bdaed9600cca
IMAGE_ARM64=quay.io/pypa/manylinux_2_28_aarch64:2026.07.19-1
IMAGE_ARM64_DIGEST=sha256:162c81dfd3efc710732a571717d3c916a6945ebf279e879ddee3243af96fe46f
IMAGE_RISCV64=quay.io/pypa/manylinux_2_39_riscv64:2026.07.19-1
IMAGE_RISCV64_DIGEST=sha256:04b3acc69a6cebb10ac1252587d202acce6445d91c783d3f92229bb2b2483069

# The derived images this tooling builds ON TOP of those. Like FlacWriter's, they install NOTHING:
# the base images already carry everything this build needs (gcc-toolset 14 / gcc 14 incl. g++,
# cmake 4.4, GNU make, binutils, file, Perl). The Containerfile only PROVES that toolchain and
# records it, so even building the derived image needs no network (build.sh builds it with
# --network none). nasm is built from the vendored source INSIDE the x86_64 container per build.
DERIVED_IMAGE_PREFIX=codebrix-av1-build

# --- Vendored source (in-repo; nothing is fetched at build time) --------------------------------
AOM_DIR=aom
AOM_VERSION=3.15.2
AOM_TARBALL_SHA256=67bb54b245f33ed98600e08269e6139986e48114e14042474ddd8885801dfddc
# nasm: BUILD-TIME TOOL ONLY (x86-64 assembly), never shipped. Built in the x86_64 container.
NASM_DIR=nasm
NASM_VERSION=2.16.03
NASM_TARBALL_SHA256=1412a1c760bbd05db026b6c0d1657affd6631cd0a63cddb6f73cc6d4aa616148

# --- The shipped library ----------------------------------------------------------------------
# DllImport("codebrix_av1") probes runtimes/<rid>/native/libcodebrix_av1.so. The shim's
# CMakeLists sets no VERSION/SOVERSION, so the build produces exactly that one regular file and its
# SONAME is the same unversioned name.
LIB_NAME=libcodebrix_av1.so
LIB_SONAME=libcodebrix_av1.so
LICENSE_AOM_NAME=LICENSE-Aom.txt

# --- CMake options ------------------------------------------------------------------------------
#   -G "Unix Makefiles"            the base images carry GNU make, not ninja; nothing is installed
#   CMAKE_BUILD_TYPE=Release       -O3 -DNDEBUG
#   CBA_BUILD_SMOKE_TEST=ON        also build codebrix_av1_smoke (the gate's verification program)
# shim/CMakeLists.txt forces libaom's options (encoder only, high bit depth, static, PIC,
# multithreaded, runtime CPU detection, no libyuv / libwebm / apps / tools / examples / tests /
# docs, nasm not yasm, version from CHANGELOG). CMAKE_C_FLAGS (set by container-build.sh) adds -g
# (for the unstripped twin) and -ffile-prefix-map so the scratch paths of the build do not end up
# in the binary.
CBA_CMAKE_OPTIONS="-DCMAKE_BUILD_TYPE=Release -DCBA_BUILD_SMOKE_TEST=ON"

# --- Verification gate ---------------------------------------------------------------------------
GLIBC_MAX_X64=2.28
GLIBC_MAX_ARM64=2.28
GLIBC_MAX_RISCV64=2.39

# Shared libraries the .so is allowed to depend on. Anything else is a gate failure.
ALLOWED_DEPS="libc.so.6 libm.so.6 libpthread.so.0 ld-linux-x86-64.so.2 ld-linux-aarch64.so.1 ld-linux-riscv64-lp64d.so.1"

# The EXACT export set (codebrix_av1.h: 17 functions). The gate fails on a missing one AND on any
# extra exported symbol - every libaom symbol must stay hidden.
REQUIRED_SYMBOLS="codebrix_av1_api_version codebrix_av1_library_version codebrix_av1_encoder_create codebrix_av1_encoder_set_int32 codebrix_av1_encoder_set_string_option codebrix_av1_encoder_start codebrix_av1_encoder_encode codebrix_av1_encoder_flush codebrix_av1_encoder_pending_packets codebrix_av1_encoder_packet_info codebrix_av1_encoder_read_packet codebrix_av1_encoder_sequence_header_length codebrix_av1_encoder_read_sequence_header codebrix_av1_encoder_frames_submitted codebrix_av1_encoder_packets_produced codebrix_av1_encoder_last_error codebrix_av1_encoder_destroy"

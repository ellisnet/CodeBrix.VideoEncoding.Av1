<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.1</TargetFramework>
    <SupportedOSPlatformVersion>33.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.codebrix.videoencoding.av1.diagnostics</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <!-- SDK / JDK defaults for this machine, the same rule as CodeBrix.Audio.FlacWriter's diagnostics app: used
       only when nothing else set them; override with -p:AndroidSdkDirectory=... -p:JavaSdkDirectory=...
       or ANDROID_HOME / JAVA_HOME. -->
  <PropertyGroup>
    <_CodeBrixUserAndroidSdk>$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))/Android/Sdk</_CodeBrixUserAndroidSdk>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('$(_CodeBrixUserAndroidSdk)')">$(_CodeBrixUserAndroidSdk)</AndroidSdkDirectory>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('/usr/lib/jvm/java-21-openjdk-amd64')">/usr/lib/jvm/java-21-openjdk-amd64</JavaSdkDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- The library under test, from source. -->
    <ProjectReference Include="..\..\src\CodeBrix.VideoEncoding.Av1\CodeBrix.VideoEncoding.Av1.csproj" />
    <!-- The independent AV1 DECODER the proof decodes the written IVF files with (it carries its own Android
         natives, so it needs nothing more than this PackageReference). -->
    <PackageReference Include="CodeBrix.VideoPlayback.Dav1d.BsdLicenseForever" Version="1.0.271.1206" />
  </ItemGroup>
  <!-- A ProjectReference does NOT carry the library's runtimes/<rid>/native/ files into the APK (they are pack-only
       items in the library csproj; only a PackageReference to the .nupkg delivers them). Name the two Android
       natives here so the build packs them into lib/<abi>/. An application that consumes the PACKAGE needs none
       of this. -->
  <ItemGroup>
    <AndroidNativeLibrary Include="..\..\src\CodeBrix.VideoEncoding.Av1\runtimes\android-arm64\native\libcodebrix_av1.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="..\..\src\CodeBrix.VideoEncoding.Av1\runtimes\android-x64\native\libcodebrix_av1.so" Abi="x86_64" />
  </ItemGroup>
</Project>
